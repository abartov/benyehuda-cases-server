= set_tab :scans, t('scans.upload_title')
= render 'scan_folders/nav'
= form_tag scan_folders_path, multipart: true, class: 'scans-form scans-page' do
  %p
    = label_tag :name, t('scans.folder_name')
    %br
    = text_field_tag :name, params[:name]
  %p
    = label_tag :title, t('scans.title')
    %br
    = text_field_tag :title, params[:title]
  %p
    = label_tag :author, t('scans.author')
    %br
    = text_field_tag :author, params[:author]
  %p
    = label_tag :files, t('scans.files')
    %br
    = file_field_tag 'files[]', multiple: true, id: 'files', accept: '.jpg,.jpeg,.png,.tif,.tiff,.pdf'
  %p
    = label_tag :comment, t('scans.comment')
    %br
    = text_area_tag :comment, params[:comment], rows: 4, cols: 60
  %p= submit_tag t('scans.upload')
