- stalled = false unless defined? stalled

.heading
  = set_tab :dashboard

.bar
  / add-nav
  %ul.add-nav
    %li
      %a.link1{ :href => dashboard_path }
        %span
          %em
            != _("back to dashboard")
    %li
      %a.link1{ :href => tasks_path(request.query_parameters.except('page', 'per_page').symbolize_keys.merge(:format => :csv)) }
        %span
          %em= t('tasks.csv.download')

!= render(:partial => "tasks/index", :locals => {:tasks => @tasks, :editing => false, :stalled => stalled, :title => _("Unassigned Tasks")})
